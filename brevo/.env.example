# ── Brevo Email Kit — environment template ─────────────────────────────
# Copy this file to .env, fill in the values, and never commit it to git.

# ── Sender (REQUIRED for both paths) ───────────────────────────────────
# A Brevo-verified address. Settings → Senders & IPs → Senders (or your own
# authenticated domain: noreply@yourdomain.com).
BREVO_SENDER=you@yourdomain.com
# Shown as the "from" name on emails.
BREVO_SENDER_NAME=Your App

# ── Path 1: Official SDK (preferred) ───────────────────────────────────
# Dashboard → SMTP & API → API Keys → "Generate a new API key".
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Path 2: SMTP relay (only needed if you use SMTP) ───────────────────
# Dashboard → SMTP & API → SMTP settings.
# NOTE: the username is the relay LOGIN (xxxxx@smtp-brevo.com), NOT your
# account email address — using the wrong one gets a 535 auth error.
BREVO_SMTP_USER=xxxxxxxxxxxxxxxx@smtp-brevo.com
BREVO_SMTP_KEY=xsmtpsib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Defaults (only override if Brevo instructs you to):
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=465        # 465 = implicit TLS, 587 = STARTTLS
