{
  "expo": {
    "name": "SuqBet",
    "slug": "suqbet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "suqbet",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.suqbet.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SuqBet uses the camera to take photos of the furniture you want to sell.",
        "NSPhotoLibraryUsageDescription": "SuqBet accesses your photos so you can add pictures to your furniture listings.",
        "NSLocationWhenInUseUsageDescription": "SuqBet uses your location to find furniture listings near you."
      }
    },
    "android": {
      "package": "com.suqbet.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF7F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBF7F0"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SuqBet to access your photos so you can list your furniture."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8A5A2B",
          "sounds": [],
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SuqBet to use your location to find furniture near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
