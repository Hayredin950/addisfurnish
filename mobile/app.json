{
  "expo": {
    "name": "AddisHome",
    "slug": "addisfurnish",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "addisfurnish",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.addisfurnish.app",
      "infoPlist": {
        "NSCameraUsageDescription": "AddisHome uses the camera to take photos of the furniture you want to sell.",
        "NSPhotoLibraryUsageDescription": "AddisHome accesses your photos so you can add pictures to your furniture listings.",
        "NSLocationWhenInUseUsageDescription": "AddisHome uses your location to find furniture listings near you."
      }
    },
    "android": {
      "package": "com.addisfurnish.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5EEE2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5EEE2"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AddisHome to access your photos so you can list your furniture."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#AC451B",
          "sounds": [],
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow AddisHome to use your location to find furniture near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "a20e2096-ff1a-49cd-8b85-77f0acf08529"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a20e2096-ff1a-49cd-8b85-77f0acf08529",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "owner": "yunus750s-team"
  }
}
