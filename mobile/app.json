{
  "expo": {
    "name": "AddisFurnish",
    "slug": "addisfurnish",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "addisfurnish",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.addisfurnish.app",
      "infoPlist": {
        "NSCameraUsageDescription": "AddisFurnish uses the camera to take photos of the furniture you want to sell.",
        "NSPhotoLibraryUsageDescription": "AddisFurnish accesses your photos so you can add pictures to your furniture listings.",
        "NSLocationWhenInUseUsageDescription": "AddisFurnish uses your location to find furniture listings near you."
      }
    },
    "android": {
      "package": "com.addisfurnish.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF7F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBF7F0"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AddisFurnish to access your photos so you can list your furniture."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8A5A2B",
          "sounds": [],
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow AddisFurnish to use your location to find furniture near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "838504d6-b211-4e5c-9df7-145b3ece145e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/838504d6-b211-4e5c-9df7-145b3ece145e"
    }
  }
}
