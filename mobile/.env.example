EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Telegram notification bot username (no @). Public — it's in the t.me link
# every user sees. Leave empty to hide the "Connect Telegram" button.
EXPO_PUBLIC_TELEGRAM_BOT_USERNAME=addisfurnish_bot

# Public web app URL, used in shared listing links (utm attribution).
EXPO_PUBLIC_SITE_URL=https://addisfurnish.vercel.app
